{
  "name": "vidia",
  "displayName": "VIDIA — NVIDIA NIM Models",
  "description": "Manage NVIDIA NIM models from build.nvidia.com in a tree view: use the free cloud endpoint, self-hosted NIM containers, or a local runtime — all integrated into the VS Code AI harness.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vidia",
          "title": "VIDIA",
          "icon": "media/temp.svg"
        }
      ]
    },
    "views": {
      "vidia": [
        {
          "id": "vidia.modelsExplorer",
          "name": "Models Explorer",
          "icon": "media/temp.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vidia.modelsExplorer",
        "contents": "No NVIDIA API key configured.\nAn API key is required to browse and query NVIDIA NIM cloud models.\n[Set NVIDIA API Key](command:vidia.setNvidiaApiKey)\n[Get API Key](https://build.nvidia.com)",
        "when": "!vidia:setupKeyExists"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "vidia",
        "displayName": "VIDIA"
      }
    ],
    "chatParticipants": [
      {
        "id": "vidia.assistant",
        "name": "vidia",
        "description": "Chat with NVIDIA NIM models managed by VIDIA",
        "isSticky": true,
        "commands": [
          {
            "name": "model",
            "description": "Pick which managed model to chat with"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          },
          {
            "name": "fix",
            "description": "Suggest a fix for the selected code"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vidia.internal.addModel",
        "title": "Add Model",
        "category": "VIDIA",
        "icon": "$(add)"
      },
      {
        "command": "vidia.ncp.addNimModelItem",
        "title": "Add NIM Model",
        "category": "VIDIA",
        "icon": "$(add)"
      },
      {
        "command": "vidia.refreshServerStatus",
        "title": "Refresh Models",
        "category": "VIDIA",
        "icon": "$(refresh)"
      },
      {
        "command": "vidia.ncp.removeModelItem",
        "title": "Remove Model",
        "category": "VIDIA",
        "icon": "$(trash)"
      },
      {
        "command": "vidia.ncp.setChatModelItem",
        "title": "Use for Chat",
        "category": "VIDIA"
      },
      {
        "command": "vidia.ncp.testModelItem",
        "title": "Test Model",
        "category": "VIDIA",
        "icon": "$(zap)"
      },
      {
        "command": "vidia.ncp.startNimItem",
        "title": "Start NIM Container",
        "category": "VIDIA",
        "icon": "$(play)"
      },
      {
        "command": "vidia.ncp.stopNimItem",
        "title": "Stop NIM Container",
        "category": "VIDIA",
        "icon": "$(stop)"
      },
      {
        "command": "vidia.ncp.showNimLogsItem",
        "title": "Show NIM Logs",
        "category": "VIDIA"
      },
      {
        "command": "vidia.setNvidiaApiKey",
        "title": "Set NVIDIA API Key",
        "category": "VIDIA"
      },
      {
        "command": "vidia.setNgcApiKey",
        "title": "Set NGC API Key",
        "category": "VIDIA"
      },
      {
        "command": "vidia.openBuildNvidia",
        "title": "Open build.nvidia.com",
        "category": "VIDIA"
      },
      {
        "command": "vidia.openSettings",
        "title": "Open Settings",
        "category": "VIDIA",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vidia.changeNvidiaApiKey",
        "title": "Change API Key",
        "category": "VIDIA",
        "icon": "$(key)"
      },
      {
        "command": "vidia.refreshCatalog",
        "title": "Refresh Model Catalog",
        "category": "VIDIA",
        "icon": "$(refresh)"
      },
      {
        "command": "vidia.clearApiKey",
        "title": "Clear API Key",
        "category": "VIDIA",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vidia.internal.addModel",
          "when": "view == vidia.modelsExplorer",
          "group": "navigation@1"
        },
        {
          "command": "vidia.refreshServerStatus",
          "when": "view == vidia.modelsExplorer",
          "group": "navigation@2"
        },
        {
          "command": "vidia.refreshCatalog",
          "when": "view == vidia.modelsExplorer",
          "group": "navigation@2"
        },
        {
          "command": "vidia.openSettings",
          "when": "view == vidia.modelsExplorer",
          "group": "navigation@3"
        },
        {
          "command": "vidia.changeNvidiaApiKey",
          "when": "view == vidia.modelsExplorer && vidia:setupKeyExists == true",
          "group": "navigation@4"
        },
        {
          "command": "vidia.clearApiKey",
          "when": "view == vidia.modelsExplorer && vidia:setupKeyExists == true",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "vidia.ncp.addNimModelItem",
          "when": "view == vidia.modelsExplorer && viewItem == group:nim",
          "group": "inline@1"
        },
        {
          "command": "vidia.openBuildNvidia",
          "when": "view == vidia.modelsExplorer && viewItem == setup",
          "group": "inline@1",
          "icon": "$(globe)"
        },
        {
          "command": "vidia.ncp.setChatModelItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:/",
          "group": "1_mod@1"
        },
        {
          "command": "vidia.ncp.testModelItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:.*:untested$/",
          "group": "inline@1",
          "icon": "$(beaker)"
        },
        {
          "command": "vidia.ncp.testModelItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:/",
          "group": "1_mod@2"
        },
        {
          "command": "vidia.ncp.startNimItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:nim/",
          "group": "2_nim@1"
        },
        {
          "command": "vidia.ncp.stopNimItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:nim/",
          "group": "2_nim@2"
        },
        {
          "command": "vidia.ncp.showNimLogsItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:nim/",
          "group": "2_nim@3"
        },
        {
          "command": "vidia.ncp.removeModelItem",
          "when": "view == vidia.modelsExplorer && viewItem =~ /^model:/",
          "group": "3_del@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vidia.ncp.removeModelItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.setChatModelItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.startNimItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.stopNimItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.showNimLogsItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.testModelItem",
          "when": "false"
        },
        {
          "command": "vidia.ncp.addNimModelItem",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "VIDIA",
      "properties": {
        "vidia.baseUrl": {
          "type": "string",
          "default": "https://integrate.api.nvidia.com/v1",
          "description": "OpenAI-compatible base URL of the NVIDIA NIM cloud endpoint."
        },
        "vidia.chatModel": {
          "type": "string",
          "default": "",
          "description": "Key of the managed model used for chat, e.g. cloud:openai/gpt-oss-20b."
        },
        "vidia.nim.containerRuntime": {
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "podman"
          ],
          "default": "auto",
          "description": "Container runtime used to launch NIM containers."
        },
        "vidia.nim.defaultPort": {
          "type": "number",
          "default": 8000,
          "description": "Default host port published for a NIM container."
        },
        "vidia.nim.remoteHost": {
          "type": "string",
          "default": "",
          "description": "Optional remote NIM host (host:port). When set, NIM models run there instead of local containers."
        },
        "vidia.localRuntime.port": {
          "type": "number",
          "default": 8000,
          "description": "Default port of the local OpenAI-compatible runtime (lemonade/ollama/NIM)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "efix": "eslint --fix src eslint.config.mjs esbuild.js"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
